# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}
# MediaPipe calls into Java classes from native code and uses protobuf reflection.
-keep class com.google.mediapipe.** { *; }
-keep class com.google.protobuf.** { *; }
-dontwarn com.google.mediapipe.**
-dontwarn com.google.protobuf.**

# Exif tag names are read by reflection when copying metadata onto saved photos.
-keepclassmembers class androidx.exifinterface.media.ExifInterface {
    public static final java.lang.String TAG_*;
}

# Kotlin compiles big utility files (CollectionsKt, StringsKt, FlowKt...) into a chain of package-private
# "Kt__" classes that extend one another. R8's partial optimization was moving some links of that chain
# to another package, so release builds crashed on launch with IllegalAccessError. Keeping their names
# keeps every link in its own package; unused ones can still be removed.
-keepnames class kotlin.**Kt__*
-keepnames class kotlinx.**Kt__*
