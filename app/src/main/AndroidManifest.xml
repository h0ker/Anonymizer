<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Keeps the CPU awake while an export runs with the screen locked. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 14 has no media-processing type yet, so exports run as data sync there. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <application
        android:name=".AnonymizerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/anonymizer"
        android:label="@string/app_name"
        android:roundIcon="@drawable/anonymizer"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anonymizer">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Anonymizer"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.export.VideoExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
    </application>

</manifest>